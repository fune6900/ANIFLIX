# Cloudflare Workers ローカル実行（npm run preview）用の環境変数
#
# `next dev` は .env.local を読むが、workerd 上で動く `npm run preview` は
# このファイル（.dev.vars）を読む。両方に同じ値を入れておくこと。
#
# 値は絶対にコミットしない。このファイルはキー名のみを記載する見本である。
# 本番（Cloudflare）へは `npx wrangler secret put <KEY>` で登録する。

# Next.js の実行モード（ローカルプレビューでは development 固定）
NEXTJS_ENV=development

# TMDb 認証（どちらか一方。Bearer 推奨）
TMDB_ACCESS_TOKEN=
# TMDB_API_KEY=

# Annict アクセストークン（キャラクター詳細 /characters/[id] で使用）
ANNICT_ACCESS_TOKEN=

# DeepL 翻訳 API キー（未設定なら翻訳をスキップして原文表示）
DEEPL_API_KEY=
