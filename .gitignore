# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (APIキーなど機密情報を含むため必ずGit管理外に)
.env*.local
.env
# Cloudflare Workers ローカル実行用のシークレット（.dev.vars.example のみコミットする）
.dev.vars

# vercel（Cloudflare へ完全移行し Vercel プロジェクトを削除したら除去する）
.vercel

# cloudflare (OpenNext ビルド成果物・wrangler ローカル状態)
/.open-next/
/.wrangler/
# `npm run cf-typegen` の生成物。.open-next/worker を参照するためコミットしない
/cloudflare-env.d.ts

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code session state
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Playwright MCP browser snapshots (検証用一時ファイル)
.playwright-mcp/
