# TMDb 認証設定（どちらか一方を設定してください）
#
# 方式1: API Read Access Token（推奨）
# https://www.themoviedb.org/settings/api の「API読み取りアクセストークン」
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here

# 方式2: API Key (v3)
# https://www.themoviedb.org/settings/api の「APIキー」
# TMDB_API_KEY=your_tmdb_api_key_here

# Annict アクセストークン（キャラクター詳細プロフィール /characters/[id] で使用）
# https://annict.com/oauth/applications で OAuth アプリケーションを作成し
# 「個人用アクセストークン」(scope: read) を発行する
# 未設定でもキャラ詳細は表示可（Annict 固有フィールドのみ欠落）
ANNICT_ACCESS_TOKEN=your_annict_access_token_here

# DeepL 翻訳 API キー（あらすじ等の英語テキストを日本語に翻訳する際に使用）
# https://www.deepl.com/pro-api で取得する
# Free 版のキーは末尾が ":fx"（例: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx）
# 未設定の場合は翻訳をスキップして原文をそのまま表示する
DEEPL_API_KEY=

# 本番環境のURL（VercelやRenderなどにデプロイ時に設定）
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Auth.js (NextAuth v5) / Google OAuth
# サイト全体を Google ログイン必須にするための設定（bot 対策）
#
# AUTH_SECRET は JWT の署名鍵。`npx auth secret` で生成する。
# 本番と開発で必ず別の値を使うこと。値を変更すると全ユーザーが強制ログアウトになる
AUTH_SECRET=
# Google Cloud Console で発行した OAuth 2.0 クライアントの認証情報
# 承認済みリダイレクト URI: https://<domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Vercel 以外（Docker / 自前ホスト）へデプロイする場合は必須。
# 未設定だと UntrustedHost エラーでログインできない
# AUTH_TRUST_HOST=true
# リバースプロキシ配下などでオリジンを自動判定できない場合のみ明示する
# AUTH_URL=https://your-domain/api/auth

# Cloudflare Turnstile（ログイン画面の bot 対策）
# https://dash.cloudflare.com/?to=/:account/turnstile でウィジェットを作成する。
# Widget Mode は Managed を選ぶ。
# 開発用と本番用でウィジェットを分け、開発用にだけ localhost を登録すること。
# 同居させるとサイトキーは公開値なので、誰でも自分の localhost で解いたトークンを
# 本番の siteverify に通せてしまう。
#
# 【必ず 2 つセットで設定すること】片方だけだとログインできなくなる。
# 未設定時の挙動:
#   - 開発（NODE_ENV != production）: 検証をスキップしてログインできる
#   - 本番: 検証を必ず失敗させる（設定漏れで bot 対策が無言で消えるのを防ぐ）
#
# NEXT_PUBLIC_TURNSTILE_SITE_KEY はビルド時にバンドルへ埋め込まれる。
# 実行時に足しても反映されないので、環境ごとにビルドし直すこと。
#
# 動作確認用の Cloudflare 公式テストキー:
#   常に成功: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
#   常に失敗: 2x00000000000000000000AB / 2x0000000000000000000000000000000AA
#   強制チャレンジ: 3x00000000000000000000FF
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
いれて